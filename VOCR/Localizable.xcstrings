    "onboarding.permissions.message" : {
      "comment" : "Message for permissions onboarding alert",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCR benötigt Berechtigungen, um OCR- und Bedienungshilfen-Funktionen bereitzustellen. Möchten Sie diese jetzt einrichten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "VOCR needs permissions to provide OCR and accessibility features. Would you like to set them up now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCR necesita permisos para proporcionar funciones de OCR y accesibilidad. ¿Le gustaría configurarlos ahora?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCR a besoin d'autorisations pour fournir des fonctionnalités d'OCR et d'accessibilité. Souhaitez-vous les configurer maintenant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VOCR necessita delle Autorizzazioni per fornire le funzioni OCR e di accessibilità. Vuoi configurarle ora?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCRはOCRおよびアクセシビリティ機能を提供するために権限が必要です。今すぐ設定しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCR이 OCR 및 손쉬운 사용 기능을 제공하려면 권한이 필요합니다. 지금 설정하시겠습니까?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VOCR trenger tillatelser for å kunne bruke OCR og tilgjengelighetsfunksjoner. Vil du konfigurere dem nå?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCR potrzebuje uprawnień, aby zapewnić funkcje OCR i dostępności. Czy chcesz je teraz skonfigurować?"
