          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCR no pudo descifrar la clave API para el ajuste preestablecido \"%@\". Abra el Administrador de ajustes preestablecidos, edite este ajuste, vuelva a introducir la clave API y guárdelo."
          }
        },
        "fr" : {
          "stringUnit" : {
