    "error.preset.decryptKey.message" : {
      "comment" : "Alert message when a preset API key cannot be decrypted",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCR konnte den API-Schlüssel für die Vorlage \"%@\" nicht entschlüsseln. Bitte öffnen Sie die Vorlagenverwaltung, bearbeiten Sie diese Vorlage, geben Sie den API-Schlüssel erneut ein und speichern Sie ihn."
