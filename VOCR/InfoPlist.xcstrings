    "NSScreenCaptureUsageDescription" : {
      "comment" : "Permission description for screen recording access",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VOCR needs to capture your screen content to perform OCR and extract text from windows and applications."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VOCR trenger å ta skjermopptakfor å utføre OCR og hente ut tekst fra vinduer og apper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCR muss Ihren Bildschirminhalt erfassen, um OCR durchzuführen und Text aus Fenstern und Anwendungen zu extrahieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VOCR necesita capturar el contenido de su pantalla para realizar OCR y extraer texto de ventanas y aplicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCR doit capturer le contenu de votre écran pour effectuer l'OCR et extraire le texte des fenêtres et des applications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VOCR deve catturare il contenuto dello schermo per eseguire l'OCR ed estrarre il testo da finestre e applicazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCRは、OCRを実行し、ウィンドウやアプリケーションからテキストを抽出するために、画面コンテンツをキャプチャする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCR은 OCR을 수행하고 창 및 응용 프로그램에서 텍스트를 추출하기 위해 화면 콘텐츠를 캡처해야 합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCR musi przechwytywać zawartość ekranu, aby wykonywać OCR i wyodrębniać tekst z okien i aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O VOCR precisa capturar o conteúdo do seu ecrã para realizar o OCR e extrair texto de janelas e aplicações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCR необходимо захватывать содержимое экрана для выполнения OCR и извлечения текста из окон и приложений."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCR потрібно захоплювати вміст вашого екрана для виконання OCR та вилучення тексту з вікон і програм."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VOCR 需要捕获您的屏幕内容以执行 OCR 并从窗口和应用程序中提取文本。"
          }
        }
      }
    }
